{
  "name": "human-craft",
  "version": "1.0.0",
  "description": "Agent Skill and static verification suite for building and scrubbing web interfaces, copy, code, repositories, and motion so no layer reads as machine-generated.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "scan": "node scripts/scan-all.mjs .",
    "scan:copy": "node scripts/scan-copy.mjs .",
    "scan:code": "node scripts/scan-code.mjs .",
    "scan:css": "node scripts/scan-css.mjs .",
    "scan:html": "node scripts/scan-html.mjs .",
    "scan:links": "node scripts/scan-links.mjs .",
    "scan:seo": "node scripts/scan-seo.mjs .",
    "scan:assets": "node scripts/scan-assets.mjs .",
    "scan:repo": "node scripts/scan-repo.mjs .",
    "scan:motion": "node scripts/scan-motion.mjs .",
    "scan:rtl": "node scripts/scan-rtl.mjs .",
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/scan-all.mjs . --quiet",
    "report": "node scripts/render-report.mjs"
  },
  "keywords": [
    "agent-skill",
    "design-engineering",
    "static-analysis",
    "copywriting",
    "arabic-rtl",
    "typography"
  ]
}
