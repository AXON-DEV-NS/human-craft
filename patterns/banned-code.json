  {
    "id": "code-react-array-index-key",
    "severity": "S2",
    "pattern": "\\.map\\(\\s*\\([^,)]+,\\s*(index|idx|i)\\s*\\)\\s*=>\\s*<[A-Za-z0-9_.]+\\s+key=\\{\\s*\\1\\s*\\}",
    "flags": "m",
