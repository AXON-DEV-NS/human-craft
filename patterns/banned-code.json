      "js",
      "ts",
      "jsx",
      "tsx",
      "mjs",
      "cjs",
      "vue",
      "svelte"
    ],
    "message": "Using array index `key={index}` on dynamic lists breaks state preservation on reorder.",
    "fix": "Use a stable unique identifier from the item (`key={invoice.id}`).",
    "positiveExample": "items.map((item, index) => <Row key={index} item={item} />)",
    "negativeExample": "invoices.map((invoice) => <InvoiceRow key={invoice.id} invoice={invoice} />)"
  },
  {
    "id": "code-react-useeffect-fetch-no-abort",
    "severity": "S2",
    "pattern": "useEffect\\(\\s*\\(\\)\\s*=>\\s*\\{\\s*fetch\\(",
    "flags": "m",
    "scope": [
      "js",
      "ts",
      "jsx",
      "tsx",
      "mjs",
      "cjs",
      "vue",
      "svelte"
    ],
    "message": "Raw `fetch()` inside `useEffect` without an `AbortController` or race protection.",
    "fix": "Pass an `AbortController` signal or load data in the route loader.",
    "positiveExample": "useEffect(() => { fetch('/api/items').then(r => r.json()); }, []);",
    "negativeExample": "useEffect(() => { const ctrl = new AbortController(); fetch('/api/items', { signal: ctrl.signal }); return () => ctrl.abort(); }, []);"
  },
