[
  {
    "id": "code-console-log-emoji",
    "severity": "S1",
    "pattern": "console\\.(log|info|warn|error)\\s*\\(\\s*['\\\"`]\\s*(🚀|✅|❌|⚠️|🔥|🎉|💡|🔍|📦|✨)",
    "flags": "m",
    "scope": [
      "js",
      "ts",
      "jsx",
      "tsx",
      "mjs",
      "cjs",
      "vue",
      "svelte"
    ],
    "message": "Emoji-prefixed `console.log` statement typical of LLM debugging output.",
    "fix": "Use structured logger calls or remove debug logs before committing.",
    "positiveExample": "console.log('🚀 Server started on port 3000');",
    "negativeExample": "logger.info({ port: 3000 }, 'http_server_listening');"
  },
  {
    "id": "code-console-error-generic-catch",
    "severity": "S2",
    "pattern": "catch\\s*\\(\\s*(error|err|e)\\s*\\)\\s*\\{\\s*console\\.error\\(\\s*['\\\"]Error:?['\\\"],\\s*\\1\\s*\\)\\s*;\\s*\\}",
    "flags": "m",
    "scope": [
      "js",
      "ts",
      "jsx",
      "tsx",
      "mjs",
      "cjs",
      "vue",
      "svelte"
    ],
    "message": "Swallowing exceptions with a generic `console.error('Error:', error)` block.",
    "fix": "Surface a typed error to the caller or render an actionable recovery state.",
    "positiveExample": "catch (error) { console.error('Error:', error); }",
    "negativeExample": "catch (err) { return { ok: false, reason: 'payment_timeout', cause: err }; }"
  },
  {
