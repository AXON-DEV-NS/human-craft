    "negativeExample": "const res = await fetch('/api/verify');"
  },
  {
    "id": "cmt-tailwind-cdn-prod-warning",
    "severity": "S0",
    "pattern": "cdn\\.tailwindcss\\.com",
    "flags": "im",
    "scope": [
      "js",
      "ts",
      "jsx",
      "tsx",
      "css",
      "html",
      "mjs"
    ],
    "message": "Play CDN `cdn.tailwindcss.com` script used in production HTML.",
    "fix": "Compile CSS at build time or use native CSS with `tokens.css`.",
