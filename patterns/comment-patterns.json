    "negativeExample": "export { parseManifest };"
  },
  {
    "id": "cmt-mock-response",
    "severity": "S0",
    "pattern": "//\\s*Simulate\\s+(API\\s+call|network\\s+request|backend\\s+response|loading)",
    "flags": "im",
    "scope": [
      "js",
      "ts",
      "jsx",
      "tsx",
      "css",
      "html",
      "mjs"
    ],
    "message": "Comment admitting simulated backend behavior.",
