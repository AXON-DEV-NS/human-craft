    "flags": "i",
    "scope": [
      "html",
      "jsx",
      "tsx",
      "vue",
      "svelte"
    ],
    "message": "Unedited framework starter `<title>`.",
    "fix": "Write a specific page title (`Page Name — Brand Name`).",
    "positiveExample": "<title>Vite + React + TS</title>",
    "negativeExample": "<title>Freight Rate Calculator — PortSaid Logistics</title>"
  },
  {
    "id": "html-meta-generator-ai",
    "severity": "S0",
