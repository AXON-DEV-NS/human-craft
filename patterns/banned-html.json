    "severity": "S1",
    "pattern": "user-scalable\\s*=\\s*(no|0)|maximum-scale\\s*=\\s*1(\\.0)?\\b",
    "flags": "i",
    "scope": [
      "html",
      "jsx",
      "tsx",
      "vue",
      "svelte"
    ],
    "message": "Disabling pinch-to-zoom violates WCAG 1.4.4.",
    "fix": "Use `width=device-width, initial-scale=1` without locking zoom.",
    "positiveExample": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">",
    "negativeExample": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
  },
  {
    "id": "html-bento-three-equal-icon-cards",
    "severity": "S2",
    "pattern": "lucide-(sparkles|zap|shield-check|rocket|cpu|globe)",
    "flags": "i",
    "scope": [
      "html",
      "jsx",
      "tsx",
      "vue",
      "svelte"
    ],
    "message": "Overused default Lucide hero/feature icon (`sparkles`, `zap`, `rocket`).",
    "fix": "Use custom technical diagrams, numbers, or domain-specific icons.",
    "positiveExample": "<svg class=\"lucide lucide-sparkles\"></svg>",
    "negativeExample": "<svg class=\"icon-caliper\" aria-hidden=\"true\"></svg>"
  },
  {
    "id": "html-mailto-example",
    "severity": "S0",
    "pattern": "href=['\\\"]mailto:(info|contact|hello|support)@(example\\.com|yourcompany\\.com|domain\\.com)['\\\"]",
    "flags": "i",
    "scope": [
      "html",
      "jsx",
      "tsx",
      "vue",
      "svelte"
    ],
    "message": "Placeholder `mailto:` address.",
    "fix": "Use the real monitored support or sales address.",
    "positiveExample": "<a href=\"mailto:hello@example.com\">Email us</a>",
    "negativeExample": "<a href=\"mailto:dispatch@portsaidlogistics.com\">dispatch@portsaidlogistics.com</a>"
  },
  {
    "id": "html-tel-placeholder",
    "severity": "S0",
    "pattern": "href=['\\\"]tel:\\+?1?[-.\\s]?(555[-.\\s]?[0-9]{3}[-.\\s]?[0-9]{4}|123[-.\\s]?456[-.\\s]?7890)['\\\"]",
    "flags": "i",
    "scope": [
      "html",
      "jsx",
      "tsx",
      "vue",
      "svelte"
    ],
    "message": "Fictional 555 or 123-456-7890 phone link.",
    "fix": "Use the real business phone number or `[CLIENT INPUT NEEDED: phone]`.",
