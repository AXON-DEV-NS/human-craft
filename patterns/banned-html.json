[
  {
    "id": "html-href-hash-empty",
    "severity": "S0",
    "pattern": "href=['\\\"]#['\\\"]",
    "flags": "i",
    "scope": [
      "html",
      "jsx",
      "tsx",
      "vue",
      "svelte"
    ],
    "message": "Dead placeholder anchor `href=\"#\"`.",
    "fix": "Point to a real route, a real section ID (`#pricing`), or use a `<button type=\"button\">` for actions.",
    "positiveExample": "<a href=\"#\">Pricing</a>",
    "negativeExample": "<a href=\"/pricing\">Pricing</a>"
  },
  {
    "id": "html-href-javascript-void",
    "severity": "S0",
    "pattern": "href=['\\\"]javascript:void\\(0\\);?['\\\"]",
    "flags": "i",
    "scope": [
      "html",
      "jsx",
      "tsx",
      "vue",
      "svelte"
    ],
    "message": "Legacy `javascript:void(0)` pseudo-link.",
    "fix": "Use a `<button type=\"button\">` for JavaScript actions.",
    "positiveExample": "<a href=\"javascript:void(0)\" onclick=\"openModal()\">Open</a>",
    "negativeExample": "<button type=\"button\" data-action=\"open-modal\">Open</button>"
  },
  {
    "id": "html-href-example-com",
    "severity": "S0",
    "pattern": "href=['\\\"]https?://(www\\.)?example\\.(com|org|net)",
    "flags": "i",
    "scope": [
      "html",
      "jsx",
      "tsx",
      "vue",
      "svelte"
    ],
    "message": "Placeholder `example.com` link left in markup.",
    "fix": "Replace with the real production URL or remove the link.",
    "positiveExample": "<a href=\"https://example.com/terms\">Terms</a>",
    "negativeExample": "<a href=\"/legal/terms\">Terms of Service</a>"
  },
  {
    "id": "html-href-localhost",
    "severity": "S0",
