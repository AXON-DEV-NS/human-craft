  {
    "id": "html-img-alt-image-of",
    "severity": "S1",
    "pattern": "<img\\b[^>]*\\balt=['\\\"](Image|Picture|Photo|Graphic|Icon)\\s+of\\s+",
    "flags": "i",
    "scope": [
      "html",
      "jsx",
      "tsx",
      "vue",
      "svelte"
    ],
    "message": "Redundant `Image of` / `Photo of` prefix in alt text.",
    "fix": "Describe what the image shows directly without saying 'Image of'.",
    "positiveExample": "<img src=\"press.jpg\" alt=\"Photo of a hydraulic press\">",
    "negativeExample": "<img src=\"press.jpg\" alt=\"200-ton hydraulic press stamping brass fittings\">"
  },
  {
    "id": "html-img-alt-placeholder",
