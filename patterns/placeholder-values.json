  {
    "id": "ph-todo-bracket",
    "severity": "S0",
    "pattern": "\\[(TODO|TBD|INSERT\\s+[^\\]]+|PLACEHOLDER[^\\]]*)\\]",
    "flags": "i",
    "scope": [
      "html",
      "md",
      "js",
      "ts",
      "jsx",
      "tsx",
      "json",
      "txt"
    ],
    "message": "Unresolved `[TODO]` / `[TBD]` / `[INSERT ...]` bracket placeholder.",
    "fix": "Fill in the real data or use the structured `[CLIENT INPUT NEEDED: specific item]` marker tracked in `client-todo.md`.",
    "positiveExample": "Price: [TBD]",
    "negativeExample": "Price: [CLIENT INPUT NEEDED: Q4 wholesale price per ton]"
  },
  {
    "id": "ph-lorem-ipsum-short",
