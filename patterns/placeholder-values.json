[
  {
    "id": "ph-example-email",
    "severity": "S0",
    "pattern": "\\b[a-zA-Z0-9._%+-]+@(example|test|domain|yourcompany|company)\\.(com|org|net)\\b",
    "flags": "i",
    "scope": [
      "html",
      "md",
      "js",
      "ts",
      "jsx",
      "tsx",
      "json",
      "txt"
    ],
    "message": "Placeholder email domain (`@example.com`, `@yourcompany.com`).",
    "fix": "Use the real organization email or `[CLIENT INPUT NEEDED: email]`.",
    "positiveExample": "Contact us at support@example.com",
    "negativeExample": "Contact us at customs@portsaidlogistics.com"
  },
  {
    "id": "ph-us-555-phone",
    "severity": "S0",
    "pattern": "\\+?1?[-.\\s]?\\(?555\\)?[-.\\s]?[0-9]{3}[-.\\s]?[0-9]{4}\\b",
    "flags": "i",
    "scope": [
      "html",
      "md",
      "js",
      "ts",
      "jsx",
      "tsx",
      "json",
      "txt"
    ],
    "message": "Fictional North American 555 phone number.",
    "fix": "Use the real business telephone number.",
    "positiveExample": "Call +1 (555) 019-2834",
    "negativeExample": "Call +20 2 2794 0112"
  },
  {
