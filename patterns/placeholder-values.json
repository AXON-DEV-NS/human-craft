  },
  {
    "id": "ph-stripe-pk-test-sample",
    "severity": "S0",
    "pattern": "\\bpk_test_51[a-zA-Z0-9]{10,}|pk_test_TYooMQauvdEDq54NiTphI7jx\\b",
    "flags": "i",
    "scope": [
      "html",
      "md",
      "js",
      "ts",
      "jsx",
      "tsx",
      "json",
      "txt"
    ],
    "message": "Hardcoded Stripe documentation test key.",
    "fix": "Read `PUBLIC_STRIPE_KEY` from environment configuration.",
    "positiveExample": "loadStripe('pk_test_TYooMQauvdEDq54NiTphI7jx')",
    "negativeExample": "loadStripe(import.meta.env.PUBLIC_STRIPE_KEY)"
  },
  {
